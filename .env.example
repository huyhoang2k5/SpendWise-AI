# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO SPENDWISE AI
# Sao chép thành .env.local và điền giá trị thật
# ========================================================

# 1. Google Gemini API Key (AI quét hóa đơn & cố vấn tài chính)
# Lấy tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Google OAuth 2.0 Client ID (Đăng nhập Google chính thức - Hướng 2)
# Lấy tại: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# 3. URL Backend API
VITE_API_URL=http://localhost:5000/api
